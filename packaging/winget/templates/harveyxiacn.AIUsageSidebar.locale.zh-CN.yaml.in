# yaml-language-server: $schema=https://aka.ms/winget-manifest.locale.1.6.0.schema.json
PackageIdentifier: harveyxiacn.AIUsageSidebar
PackageVersion: @@VERSION@@
PackageLocale: zh-CN
Publisher: Harvey Xia
PublisherUrl: https://github.com/harveyxiacn
PublisherSupportUrl: https://github.com/harveyxiacn/AI-usage-monitor-sidebar/issues
PackageName: AI Usage Sidebar
PackageUrl: https://github.com/harveyxiacn/AI-usage-monitor-sidebar
License: MIT
