{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage Sidebar",
  "version": "0.2.0",
  "identifier": "io.github.harveyxiacn.ai-usage-sidebar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "sidebar",
        "url": "/",
        "title": "AI Usage Sidebar",
        "width": 96,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "popover",
        "url": "/popover",
        "title": "AI Usage Details",
        "width": 360,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "dashboard",
        "url": "/dashboard",
        "title": "AI Usage Sidebar — Dashboard",
        "width": 1040,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "AI Usage Sidebar"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/harveyxiacn/AI-usage-monitor-sidebar/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMzhCREY2RjI4MzI2RUUKUldUdUpvUHk5cjA0bnJVV1JOS2pxQTA3SXlFMm40b2lvM0Y1Y1FMSTY2Z3NhNFF6ei9OVVpnL0YK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "rpm", "appimage", "dmg", "app", "nsis", "msi"],
    "category": "DeveloperTool",
    "publisher": "Harvey Xia",
    "homepage": "https://github.com/harveyxiacn/AI-usage-monitor-sidebar",
    "copyright": "Copyright © 2026 Harvey Xia. MIT licensed.",
    "shortDescription": "Claude Code / Codex quota sidebar",
    "longDescription": "An always-on-top edge sidebar showing Claude Code and OpenAI Codex rate-limit quotas, with token usage history.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"],
        "desktopTemplate": "main.desktop"
      },
      "rpm": {
        "desktopTemplate": "main.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
