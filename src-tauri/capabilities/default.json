{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permission set for the sidebar, popover and dashboard windows. Everything the UI does goes through the app's own commands; these are only the core APIs the frontend touches directly.",
  "windows": ["sidebar", "popover", "dashboard"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:window:allow-start-dragging",
    "core:window:allow-scale-factor",
    "core:window:allow-current-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-primary-monitor",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-theme",
    "core:app:allow-version",
    "opener:allow-open-url",
    "notification:default",
    "process:allow-exit",
    "log:default"
  ]
}
