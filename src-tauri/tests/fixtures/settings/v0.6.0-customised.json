  "refreshIntervalSec": 180,
  "adaptiveRefresh": false,
  "providers": {
    "claude": {
      "enabled": true,
      "showInSidebar": true,
      "order": 1
    },
    "codex": {
      "enabled": false,
      "showInSidebar": false,
      "order": 0
    },
    "copilot": {
      "enabled": false,
      "showInSidebar": true,
      "order": 2
    },
    "openrouter": {
      "enabled": true,
      "showInSidebar": true,
      "order": 3
    }
  },
  "ingestEnabled": false,
  "pricingUrl": "https://example.com/pricing.json",
