  "colors": {
    "claude": "#112233",
    "codex": "#10a37f",
    "copilot": "#8250df",
    "warn": "#f5c542",
    "critical": "#ff3b30",
    "surface": "#101010",
    "text": "",
    "openrouter": "#abcdef"
  },
  "sizes": {
    "ringSize": 64,
    "ringStroke": 4.5,
    "barGap": 18,
    "barPadding": 10,
    "cornerRadius": 26,
    "labelSize": 13
