{
  "version": 1,
  "language": "zh-CN",
  "theme": "light",
  "surfaceStyle": "cyber",
  "cyberAccent": "synthwave",
  "edge": "left",
  "verticalAlign": "top",
  "verticalOffset": 120,
  "monitor": "DISPLAY2",
  "autoHide": true,
  "autoHideDelayMs": 1500,
  "popoverTimeoutSec": 25,
  "collapsedWidth": 10,
  "ringMode": "all",
